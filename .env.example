# ===== مطلوب =====
API_ID=1234567
API_HASH=your_api_hash
BOT_TOKEN=123456:ABC...
# OAuth client من نوع "TVs and Limited Input devices"
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# ===== على Railway (لازم مع الـ Volume) =====
DATA_DIR=/data
TMP_DIR=/data/tmp

# ===== اختياري =====
ALLOWED_USERS=                  # IDs مفصولة بفاصلة. فاضي = الكل
MAX_JOBS=2
DEFAULT_FOLDER=Telegram Uploads
SESSION_STRING=                 # وضع Userbot للملفات حتى 4GB (Premium) - من gen_session.py
